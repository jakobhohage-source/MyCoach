{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git branch -d:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(node scripts/check-js.mjs)",
      "Bash(python3 -m http.server:*)"
    ],
    "ask": [
      "Bash(git push origin main:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * --delete *)",
      "Bash(git reset:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
